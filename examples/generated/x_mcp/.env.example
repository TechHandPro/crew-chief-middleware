# Environment for the x MCP server (X API Posts (curated)).
# Copy to .env for local use, or inject these variables from your secret manager.
# Never commit real credentials: the generated server reads them from the
# environment only and no secret is ever written into tools.json.

# --- credentials (auth type: bearer) ---
X_API_TOKEN=

# --- endpoint ---
# Base URL. Defaults to the spec's server: https://api.x.com
#X_BASE_URL=https://api.x.com

# --- safety and limits (all optional) ---
# Expose only non-mutating tools (GET/HEAD/OPTIONS):
#X_READ_ONLY=1
# Per-request timeout in seconds (default 30):
#X_TIMEOUT_SECONDS=30
# Truncate responses above this many bytes to protect the agent's context (default 100000):
#X_MAX_RESPONSE_BYTES=100000
# Retries for idempotent requests on 429/502/503/504 (default 2):
#X_MAX_RETRIES=2
# Allow plaintext http to a non-loopback host (off by default; credentials would travel unencrypted):
#X_ALLOW_INSECURE_HTTP=0
# Runtime log level on stderr: DEBUG, INFO, WARNING, ERROR (default WARNING):
#X_LOG_LEVEL=WARNING
